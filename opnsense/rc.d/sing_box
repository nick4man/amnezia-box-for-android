#!/bin/sh
#
# PROVIDE: sing_box
# REQUIRE: LOGIN FILESYSTEMS defaultroute
# KEYWORD: shutdown
#
# sing_box_enable (bool):    Set to NO by default. YES to enable sing-box.
# sing_box_config (path):    Config file. Default /usr/local/etc/sing-box/config.json
# sing_box_workdir (path):   Working directory. Default /var/db/sing-box
# sing_box_logfile (path):   Where daemon(8) sends stdout/stderr. Default
#                            /var/log/sing-box/sing-box.log — note that a `log.output`
#                            in the config takes over from sing-box's side.
# sing_box_flags (str):      Extra flags passed to `sing-box run`.
#
# Beyond the usual start/stop/restart/status this script understands:
#   configtest   validate the config without touching the running service
#   reload       validate, then SIGHUP the daemon (sing-box reloads in place and
#                keeps running on a bad config)

. /etc/rc.subr

name="sing_box"
rcvar="sing_box_enable"
desc="sing-box universal proxy platform (AmneziaWG)"

load_rc_config $name

: ${sing_box_enable:="NO"}
: ${sing_box_config:="/usr/local/etc/sing-box/config.json"}
: ${sing_box_workdir:="/var/db/sing-box"}
: ${sing_box_logfile:="/var/log/sing-box/sing-box.log"}
: ${sing_box_flags:=""}

pidfile="/var/run/${name}.pid"
procname="/usr/local/bin/sing-box"
command="/usr/sbin/daemon"
# -p (child pidfile) rather than -P: rc.subr matches the pid against
# ${procname}, so start/stop/status control sing-box itself, not daemon(8).
command_args="-f -p ${pidfile} -t ${name} -o ${sing_box_logfile} ${procname} -D ${sing_box_workdir} -c ${sing_box_config} ${sing_box_flags} run"

extra_commands="configtest reload"
configtest_cmd="sing_box_configtest"
reload_precmd="sing_box_configtest"
sig_reload="HUP"

start_precmd="sing_box_prestart"

sing_box_configtest()
{
    if [ ! -f "${sing_box_config}" ]; then
        err 1 "${sing_box_config} does not exist - copy config.json.sample and edit it"
    fi
    ${procname} check -c "${sing_box_config}" || err 1 "invalid config: ${sing_box_config}"
    echo "${sing_box_config}: ok"
}

sing_box_prestart()
{
    /bin/mkdir -p "${sing_box_workdir}" "$(dirname "${sing_box_logfile}")"
    sing_box_configtest > /dev/null
}

run_rc_command "$1"
